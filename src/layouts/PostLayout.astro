---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { categoryColor } from '../utils/categoryColor';
import { site, fmtDate } from '../data/site';

interface Props {
  slug: string;
  title: string;
  description: string;
  category: string;
  date: Date;
  updated?: Date;
  translation?: string;
  readingTime?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { slug, title, description, category, date, updated, translation, readingTime, image, imageAlt } = Astro.props;
const { t } = site;

const alternate = translation ? site.alternate(translation) : undefined;

const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const idx = all.findIndex((p) => p.id === slug);
const newer = idx > 0 ? all[idx - 1] : undefined;
const older = idx >= 0 ? all[idx + 1] : undefined;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: image ? new URL(image.src, Astro.site).toString() : undefined,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Fernando Lisboa',
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/images/robot-logo.png', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
  },
};
---
<BaseLayout title={title} description={description} image={image?.src} type="article" alternate={alternate}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <div class="progress" id="progress" aria-hidden="true"></div>

  <article>
    <header class="art-h grid-bg">
      <div class="container">
        <p class="crumb">
          <a href="/">{t.home}</a><span>/</span><a href="/blog">{t.blog}</a><span>/</span><a href={`/blog?category=${encodeURIComponent(category)}`}>{category}</a>
        </p>
        <span class="chip" style={`--chip:${categoryColor(category)}`}>{category}</span>
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <div class="by">
          <div class="who">
            <img src="/images/fernando-lisboa.png" alt="" width="40" height="40" />
            <div>
              <strong>Fernando Lisboa</strong>
              <span class="role">{t.authorRole}</span>
            </div>
          </div>
          <p class="meta">
            <span>{t.published} {fmtDate(date)}</span>
            {updated && <><i>/</i><span>{t.updated} {fmtDate(updated)}</span></>}
            {readingTime && <><i>/</i><span class="rt">{readingTime}</span></>}
          </p>
          <ShareButtons title={title} />
        </div>
        {alternate && (
          <p class="translation"><a href={alternate.href} hreflang={alternate.lang} lang={alternate.lang}>{t.translationLink}</a></p>
        )}
      </div>
    </header>

    {image && (
      <figure class="container cover">
        <Image
          src={image}
          alt={imageAlt ?? title}
          width={1200}
          height={540}
          widths={[480, 800, 1200]}
          sizes="(max-width: 1180px) 100vw, 1132px"
          quality={72}
          priority
        />
      </figure>
    )}

    <div class="container art-layout" id="art-layout">
      <aside class="side" id="toc-side">
        <p class="eyebrow">{t.inThisArticle}</p>
        <nav class="toc" aria-label={t.inThisArticle}></nav>
      </aside>

      <div class="art-main">
        <details class="toc-m" id="toc-m">
          <summary><span class="eyebrow">{t.inThisArticle}</span></summary>
          <nav class="toc"></nav>
        </details>

        <div class="prose" id="prose">
          <slot />
        </div>

        <ShareButtons title={title} variant="end" />

        <AuthorBio />

        {(newer || older) && (
          <nav class="pn">
            {older ? (
              <a href={site.postHref(older.id)} rel="prev"><span>{t.prev}</span><strong>{older.data.title}</strong></a>
            ) : <span></span>}
            {newer ? (
              <a href={site.postHref(newer.id)} rel="next" class="nx"><span>{t.next}</span><strong>{newer.data.title}</strong></a>
            ) : <span></span>}
          </nav>
        )}
      </div>
    </div>
  </article>

</BaseLayout>

<script>
  import { site } from '../data/site';

  // ---- Barra de progresso de leitura ----
  const bar = document.getElementById('progress');
  const prose = document.getElementById('prose');
  function updateProgress() {
    if (!bar || !prose) return;
    const rect = prose.getBoundingClientRect();
    const total = rect.height - window.innerHeight * 0.6;
    const done = Math.min(Math.max(-rect.top + window.innerHeight * 0.2, 0), Math.max(total, 1));
    bar.style.transform = `scaleX(${total > 0 ? done / total : 0})`;
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  updateProgress();

  // ---- Índice lateral gerado a partir dos títulos do artigo ----
  const heads = Array.from(document.querySelectorAll<HTMLElement>('#prose h2'));
  const navs = document.querySelectorAll<HTMLElement>('.toc');
  if (heads.length >= 2 && heads.every((h) => h.id)) {
    const html = heads
      .map((h) => `<a href="#${h.id}" data-id="${h.id}" >${h.textContent}</a>`)
      .join('');
    navs.forEach((n) => (n.innerHTML = html));

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
    const setActive = (id: string) =>
      links.forEach((a) => a.classList.toggle('on', a.dataset.id === id));

    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -65% 0px' },
    );
    heads.forEach((h) => io.observe(h));

    document.getElementById('toc-m')?.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => document.getElementById('toc-m')?.removeAttribute('open')),
    );
  } else {
    document.getElementById('toc-side')?.remove();
    document.getElementById('toc-m')?.remove();
    document.getElementById('art-layout')?.classList.add('no-toc');
  }

  // ---- Botão "copiar" dos blocos de prompt ----
  function legacyCopy(text: string): boolean {
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    document.body.removeChild(textarea);
    return ok;
  }

  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.copy-btn');
    if (!button) return;

    const targetId = button.dataset.copyTarget;
    const target = targetId && document.getElementById(targetId);
    if (!target) return;

    const text = target.textContent?.trim() ?? '';
    const original = button.textContent;

    const showFeedback = (label: string, isError: boolean) => {
      button.textContent = label;
      button.classList.toggle('copied', !isError);
      button.classList.toggle('copy-error', isError);
      setTimeout(() => {
        button.textContent = original;
        button.classList.remove('copied', 'copy-error');
      }, 1500);
    };

    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(text).then(
        () => showFeedback(site.t.copied, false),
        () => {
          const ok = legacyCopy(text);
          showFeedback(ok ? site.t.copied : site.t.copyFallback, !ok);
        },
      );
    } else {
      const ok = legacyCopy(text);
      showFeedback(ok ? site.t.copied : site.t.copyFallback, !ok);
    }
  });
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    height: 2px;
    background: linear-gradient(90deg, var(--violet), var(--rose));
    transform: scaleX(0);
    transform-origin: left;
  }

  .art-h {
    border-bottom: 1px solid var(--line);
    padding-block: 36px 32px;
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 22px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .crumb a {
    text-decoration: none;
  }

  .crumb a:hover {
    color: var(--link-text);
  }

  .crumb a:last-child {
    color: var(--ink-strong);
  }

  h1 {
    max-width: 22ch;
    margin: 16px 0 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.045em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .lead {
    max-width: 60ch;
    margin: 18px 0 0;
    color: var(--ink-soft);
    font-size: 1.15rem;
    line-height: 1.55;
  }

  .by {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .who img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .who strong {
    display: block;
    font-size: 0.92rem;
    color: var(--ink-strong);
    line-height: 1.2;
  }

  .role {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .by .meta {
    flex: 1;
  }

  .rt {
    color: var(--teal-text);
  }

  .translation {
    margin: 16px 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .translation a {
    color: var(--link-text);
    text-decoration: none;
    border-bottom: 1px dashed var(--violet);
  }

  .cover {
    margin: 32px auto 0;
  }

  .cover :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 540;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .art-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 720px);
    justify-content: center;
    gap: 64px;
    padding-block: 44px 8px;
  }

  .art-layout.no-toc {
    grid-template-columns: minmax(0, 720px);
  }

  .side {
    position: sticky;
    top: 88px;
    align-self: start;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
  }

  .side .eyebrow {
    margin: 0 0 14px;
  }

  .toc {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
  }

  .toc :global(a) {
    margin-left: -1px;
    padding: 6px 0 6px 14px;
    border-left: 2px solid transparent;
    font-size: 0.84rem;
    line-height: 1.35;
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .toc :global(a.sub) {
    padding-left: 28px;
    font-size: 0.8rem;
  }

  .toc :global(a:hover) {
    color: var(--ink-strong);
  }

  .toc :global(a.on) {
    color: var(--ink-strong);
    border-left-color: var(--violet);
  }

  .toc-m {
    display: none;
    margin-bottom: 28px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
  }

  .toc-m summary {
    padding: 12px 16px;
    cursor: pointer;
    list-style: none;
  }

  .toc-m summary::-webkit-details-marker {
    display: none;
  }

  .toc-m summary::after {
    content: '+';
    float: right;
    font-family: var(--font-mono);
    color: var(--link-text);
  }

  .toc-m[open] summary::after {
    content: '−';
  }

  .toc-m .toc {
    margin: 0 16px 14px;
  }

  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 40px;
  }

  .pn a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .pn a:hover {
    border-color: var(--violet);
  }

  .pn .nx {
    text-align: right;
  }

  .pn span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--link-text);
  }

  .pn strong {
    font-size: 0.95rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--ink-strong);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 960px) {
    .art-layout {
      grid-template-columns: minmax(0, 720px);
      gap: 0;
    }

    .side {
      display: none;
    }

    .toc-m {
      display: block;
    }
  }

  @media (max-width: 600px) {
    .art-h {
      padding-block: 28px 24px;
    }

    .by .meta {
      flex-basis: 100%;
    }

    .pn {
      grid-template-columns: 1fr;
    }

    .cover :global(img) {
      aspect-ratio: 16 / 10;
    }
  }

  /* Blocos de prompt (HTML dentro dos artigos) */
  :global(.prompt-card) {
    margin: 28px 0;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--ink-deep);
  }

  :global(.prompt-card-bar) {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    background: color-mix(in srgb, var(--ink-deep) 88%, #fff);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  :global(.prompt-card-bar .dot) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  :global(.prompt-card-bar .dot-red) {
    background: #ff5f56;
  }

  :global(.prompt-card-bar .dot-yellow) {
    background: #ffbd2e;
  }

  :global(.prompt-card-bar .dot-green) {
    background: #27c93f;
  }

  :global(.prompt-card-label) {
    margin-left: 6px;
    flex: 1;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.5);
  }

  :global(.copy-btn) {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 11px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
    color: #ece7fb;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  :global(.copy-btn:hover) {
    border-color: var(--teal-soft);
    color: var(--teal-soft);
  }

  :global(.copy-btn.copied) {
    background: var(--teal);
    border-color: var(--teal);
    color: #ffffff;
  }

  :global(.copy-btn.copy-error) {
    background: var(--rose);
    border-color: var(--rose);
    color: #ffffff;
  }

  :global(.prompt-card pre) {
    margin: 0;
    border: 0;
    border-radius: 0;
  }
</style>
