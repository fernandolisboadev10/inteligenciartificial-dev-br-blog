---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Prompts de IA testados e fluxos de trabalho para desenvolvedores.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'dark' || storedTheme === 'light') {
        document.documentElement.setAttribute('data-theme', storedTheme);
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="-tDgPKFSgBPg9tLKzyO5i2wvzNrYFMj0jC9yy8IaT5c" />
    <!-- TODO: verificação do Bing Webmaster Tools pendente pra este domínio -->
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title} · inteligenciartificial.dev.br</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HCTMEQRYFZ"></script>
    <script is:inline>
      // Consent: EU/UK-style timezones start denied (opt-in); everywhere else starts granted (opt-out).
      // The visitor's choice is stored in localStorage under "cookie-consent".
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      (function () {
        var tz = '';
        try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
        var strict = tz.indexOf('Europe/') === 0 ||
          ['Atlantic/Canary','Atlantic/Madeira','Atlantic/Azores','Atlantic/Faroe','Atlantic/Reykjavik','Asia/Nicosia','Asia/Famagusta'].indexOf(tz) !== -1;
        var stored = null;
        try { stored = localStorage.getItem('cookie-consent'); } catch (e) {}
        var state = (stored === 'granted' || stored === 'denied') ? stored : (strict ? 'denied' : 'granted');

        gtag('consent', 'default', {
          ad_storage: state, analytics_storage: state, ad_user_data: state, ad_personalization: state
        });
        gtag('js', new Date());
        gtag('config', 'G-HCTMEQRYFZ');

        window.siteConsent = {
          hasChoice: function () { return stored === 'granted' || stored === 'denied'; },
          set: function (value) {
            stored = value;
            try { localStorage.setItem('cookie-consent', value); } catch (e) {}
            gtag('consent', 'update', {
              ad_storage: value, analytics_storage: value, ad_user_data: value, ad_personalization: value
            });
          }
        };
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
