---
import NewsletterForm from './NewsletterForm.astro';

const categories = [
  { label: 'Início', href: '/' },
  { label: 'Chatbots', href: '/blog?category=Chatbots' },
  { label: 'Prompts', href: '/blog?category=Engenharia+de+Prompt' },
  { label: 'Ferramentas de IA', href: '/blog?category=Ferramentas+de+IA+para+C%C3%B3digo' },
  { label: 'Reviews', href: '/blog?category=Reviews' },
  { label: 'Tutoriais', href: '/blog?category=Tutoriais' },
  { label: 'Estudos de Caso', href: '/blog?category=Estudos+de+Caso' },
];

const quickLinks = [
  { label: 'Sobre nós', href: '/about' },
  { label: 'Contato', href: '/contact' },
  { label: 'Anuncie', href: '/advertise' },
];
---
<footer class="site-footer">
  <div class="container grid">
    <div class="about-col">
      <a href="/" class="brand">
        <img src="/images/robot-logo.png" alt="" width="26" height="26" />
        <span class="brand-text"><span class="brand-gradient">Inteligência Artificial</span><span class="brand-divider">|</span>Dev</span>
      </a>
      <p class="tagline">
        Inteligência Artificial Dev é seu guia prático de engenharia de
        prompt e ferramentas de IA para desenvolvedores. Entregamos prompts
        testados e comparações honestas pra você construir software mais
        rápido com IA.
      </p>
    </div>

    <div>
      <p class="col-title">Links Rápidos</p>
      <ul>
        {quickLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="col-title">Categorias</p>
      <ul>
        {categories.map((c) => (
          <li><a href={c.href}>{c.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="col-title">Newsletter</p>
      <p class="newsletter-copy">Assine nossa newsletter e receba novidades, notícias e prompts gratuitos.</p>
      <NewsletterForm compact />
    </div>
  </div>

  <div class="bottom">
    <div class="container bottom-inner">
      <p>© {new Date().getFullYear()} Inteligência Artificial Dev. Todos os direitos reservados.</p>
      <div class="legal-links">
        <a href="/privacy-policy">Política de Privacidade</a>
        <a href="/terms-of-use">Termos de Uso</a>
        <a href="/cookie-policy">Política de Cookies</a>
        <a href="/transparency">Transparência</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: 40px;
    padding-block: 56px 40px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    margin: 0 0 16px;
  }

  .brand-text {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.01em;
    color: var(--ink-strong);
  }

  .brand-gradient {
    background: linear-gradient(135deg, var(--violet), var(--rose));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .brand-divider {
    margin: 0 6px;
    color: var(--line);
  }

  .tagline {
    color: var(--ink-soft);
    font-size: 0.9rem;
    max-width: 38ch;
    margin: 0 0 20px;
  }

  .col-title {
    position: relative;
    font-size: 0.95rem;
    color: var(--ink-strong);
    font-weight: 700;
    margin: 0 0 20px;
    padding-bottom: 12px;
  }

  .col-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 32px;
    height: 3px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
  }

  .newsletter-copy {
    color: var(--ink-soft);
    font-size: 0.9rem;
    margin: 0 0 16px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  ul a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  ul a:hover {
    color: var(--teal);
  }

  .bottom {
    background: var(--ink-deep);
  }

  .bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 20px;
  }

  .bottom-inner p {
    margin: 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .legal-links a {
    text-decoration: none;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .legal-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
