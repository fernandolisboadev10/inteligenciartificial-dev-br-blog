---
import Brand from './Brand.astro';

const categories = [
  { label: 'Início', href: '/' },
  { label: 'Chatbots', href: '/blog?category=Chatbots' },
  { label: 'Prompts', href: '/blog?category=Prompts' },
  { label: 'Ferramentas de IA', href: '/blog?category=Ferramentas+de+IA' },
  { label: 'Tutoriais', href: '/blog?category=Tutoriais' },
  { label: 'Estudos de Caso', href: '/blog?category=Estudos+de+Caso' },
  { label: 'Carreira', href: '/blog?category=Carreira' },
];

const quickLinks = [
  { label: 'Sobre nós', href: '/about' },
  { label: 'Contato', href: '/contact' },
  { label: 'Anuncie', href: '/advertise' },
];
---
<footer class="site-footer">
  <div class="container grid">
    <div class="about-col">
      <Brand size={26} />
      <p class="tagline">
        Inteligência Artificial Dev é seu guia prático de engenharia de
        prompt e ferramentas de IA para desenvolvedores. Entregamos prompts
        testados e comparações honestas pra você construir software mais
        rápido com IA.
      </p>
    </div>

    <div>
      <p class="col-title">Links Rápidos</p>
      <ul>
        {quickLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="col-title">Categorias</p>
      <ul class="cats" style={`grid-template-rows: repeat(${Math.ceil(categories.length / 2)}, auto)`}>
        {categories.map((c) => (
          <li><a href={c.href}>{c.label}</a></li>
        ))}
      </ul>
    </div>

  </div>

  <div class="bottom">
    <div class="container bottom-inner">
      <p>© {new Date().getFullYear()} Inteligência Artificial Dev. Todos os direitos reservados.</p>
      <div class="legal-links">
        <a href="/privacy-policy">Política de Privacidade</a>
        <a href="/terms-of-use">Termos de Uso</a>
        <a href="#" data-open-cookie-settings>Configurações de cookies</a>
        <a href="/cookie-policy">Política de Cookies</a>
        <a href="/transparency">Transparência</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.6fr 0.9fr 1.5fr;
    gap: 40px;
    padding-block: 52px 40px;
  }

  .about-col :global(.brand) {
    margin: 0 0 16px;
  }

  .tagline {
    color: var(--ink-soft);
    font-size: 0.9rem;
    max-width: 38ch;
    margin: 0 0 20px;
  }

  .col-title {
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-strong);
  }

  .col-title::before {
    content: '// ';
    color: var(--link-text);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  ul.cats {
    display: grid;
    grid-auto-flow: column;
    column-gap: 32px;
    row-gap: 9px;
  }

  ul a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }

  ul a:hover {
    color: var(--link-text);
  }

  .bottom {
    background: var(--ink-deep);
  }

  .bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 18px;
  }

  .bottom-inner p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.7);
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .legal-links a {
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.7);
  }

  .legal-links a:hover {
    color: #ffffff;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
