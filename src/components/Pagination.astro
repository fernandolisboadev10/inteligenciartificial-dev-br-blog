---
import { site } from '../data/site';

interface Props {
  current: number;
  total: number;
}
const { current, total } = Astro.props;

const href = (n: number) => (n === 1 ? '/' : `/page/${n}/`);
const pad = (n: number) => String(n).padStart(2, '0');

const wanted = new Set<number>([1, 2, current - 1, current, current + 1, total - 1, total]);
if (current <= 3) [3, 4].forEach((n) => wanted.add(n));
const pages = [...wanted].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
const items: (number | null)[] = [];
pages.forEach((n, i) => {
  if (i > 0 && n - pages[i - 1] > 1) items.push(null);
  items.push(n);
});
---
{total > 1 && (
  <nav class="pager" aria-label={site.t.pagination}>
    {current > 1 && <a class="pg" href={href(current - 1)} rel="prev" aria-label={site.t.previous}>←</a>}
    {items.map((n) =>
      n === null ? (
        <span class="pg gap" aria-hidden="true">…</span>
      ) : n === current ? (
        <span class="pg active" aria-current="page">{pad(n)}</span>
      ) : (
        <a class="pg" href={href(n)}>{pad(n)}</a>
      ),
    )}
    {current < total && <a class="pg" href={href(current + 1)} rel="next" aria-label={site.t.nextPage}>→</a>}
  </nav>
)}

<style>
  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 44px;
  }

  .pg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 42px;
    height: 42px;
    padding: 0 8px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  a.pg:hover {
    border-color: var(--violet);
    color: var(--link-text);
  }

  .pg.active {
    border-color: transparent;
    background: linear-gradient(135deg, var(--violet), var(--rose));
    color: #fff;
  }

  .pg.gap {
    border-color: transparent;
    background: transparent;
    min-width: 24px;
  }
</style>
