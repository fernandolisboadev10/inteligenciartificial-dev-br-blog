---
// Mosaico da home: 1 destaque grande, 2 cartões com imagem e 3 linhas compactas.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { categoryColor } from '../utils/categoryColor';
import { site, fmtDate } from '../data/site';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
const [main, ...rest] = posts;
const tiles = rest.slice(0, 2);
const rows = rest.slice(2, 5);
---
{main && (
  <div class="mosaic">
    <a href={site.postHref(main.id)} class="tile big">
      {main.data.image && <Image src={main.data.image} alt={main.data.imageAlt ?? main.data.title} width={960} height={640} quality={72} priority />}
      <div class="shade"></div>
      <div class="tile-body">
        <span class="chip" style={`--chip:${categoryColor(main.data.category)}`}>{main.data.category}</span>
        <h3>{main.data.title}</h3>
        <p class="desc">{main.data.description}</p>
        <p class="meta">{fmtDate(main.data.date)}{main.data.readingTime && <><i>/</i>{main.data.readingTime}</>}</p>
      </div>
    </a>

    {tiles.map((p) => (
      <a href={site.postHref(p.id)} class="tile">
        {p.data.image && <Image src={p.data.image} alt={p.data.imageAlt ?? p.data.title} width={640} height={420} quality={72} />}
        <div class="shade"></div>
        <div class="tile-body">
          <span class="chip" style={`--chip:${categoryColor(p.data.category)}`}>{p.data.category}</span>
          <h3>{p.data.title}</h3>
          <p class="meta">{fmtDate(p.data.date)}{p.data.readingTime && <><i>/</i>{p.data.readingTime}</>}</p>
        </div>
      </a>
    ))}

    <div class="rows">
      {rows.map((p, i) => (
        <a href={site.postHref(p.id)} class="row">
          <b>{String(i + 1).padStart(2, '0')}</b>
          <div class="row-body">
            <span class="cat">{p.data.category}</span>
            <h3>{p.data.title}</h3>
          </div>
          <div class="row-thumb">
            {p.data.image && <Image src={p.data.image} alt="" width={160} height={110} quality={65} />}
          </div>
        </a>
      ))}
    </div>
  </div>
)}

<style>
  .mosaic {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: 270px auto;
    gap: 16px;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  .tile {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 240px;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--ink-deep);
    color: #fff;
    transition: border-color 0.18s ease;
  }

  .tile:hover {
    border-color: var(--violet);
  }

  .big {
    grid-row: 1 / span 2;
    min-height: 460px;
  }

  .tile img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .tile:hover img {
    transform: scale(1.04);
  }

  .shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 6, 16, 0) 0%, rgba(8, 6, 16, 0.5) 40%, rgba(8, 6, 16, 0.94) 78%, rgba(8, 6, 16, 0.97) 100%);
  }

  .tile-body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 20px 22px;
    width: 100%;
  }

  .tile h3 {
    font-size: 1.05rem;
    line-height: 1.25;
    color: #fff;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .big .tile-body {
    padding: 28px 32px;
    max-width: 42rem;
  }

  .big h3 {
    font-size: clamp(1.4rem, 2.3vw, 2rem);
    letter-spacing: -0.035em;
  }

  .desc {
    margin: 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tile .meta {
    color: rgba(255, 255, 255, 0.7);
  }

  .rows {
    grid-column: 2 / span 2;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    overflow: hidden;
  }

  .row {
    flex: 1;
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr) 92px;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    transition: background 0.15s ease;
  }

  .row + .row {
    border-top: 1px solid var(--line);
  }

  .row:hover {
    background: color-mix(in srgb, var(--violet) 7%, var(--surface));
  }

  .row b {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--link-text);
  }

  .row-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cat {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .row h3 {
    font-size: 0.95rem;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.015em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s ease;
  }

  .row:hover h3 {
    color: var(--link-text);
  }

  .row-thumb {
    height: 58px;
    border-radius: 4px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--violet-soft), var(--rose-soft));
  }

  .row-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 960px) {
    .mosaic {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
    }

    .big {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 380px;
    }

    .rows {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .mosaic {
      grid-template-columns: 1fr;
    }

    .big {
      min-height: 340px;
    }

    .big .tile-body {
      padding: 22px;
    }

    .row {
      grid-template-columns: 24px minmax(0, 1fr) 72px;
      gap: 10px;
    }
  }
</style>
