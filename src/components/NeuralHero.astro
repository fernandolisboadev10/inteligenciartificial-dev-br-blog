---
// Abertura da home: título e subtítulo sobre uma rede neural animada (canvas), colorida e reativa ao mouse.
interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
---
<section class="neural-hero" id="neural-hero">
  <canvas class="neural-canvas" aria-hidden="true"></canvas>
  <div class="container hero-content">
    <h1>{title}</h1>
    <p>{subtitle}</p>
  </div>
</section>

<script>
  const hero = document.getElementById('neural-hero');
  const canvas = hero?.querySelector<HTMLCanvasElement>('.neural-canvas');
  const ctx = canvas?.getContext('2d');

  if (hero && canvas && ctx) {
    const DARK = ['#22d3ee', '#a78bfa', '#f472b6', '#34d399', '#fbbf24'];
    const LIGHT = ['#0891b2', '#7c3aed', '#db2777', '#059669', '#d97706'];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');

    type Node = { x: number; y: number; vx: number; vy: number; r: number; c: number; glow: number };
    type Pulse = { a: Node; b: Node; t: number; speed: number };

    let w = 0;
    let h = 0;
    let dpr = 1;
    let linkDist = 130;
    let nodes: Node[] = [];
    let pulses: Pulse[] = [];
    let palette = DARK;
    let alphaBoost = 1;
    let raf = 0;
    let running = false;
    let ready = false;
    let small = false;
    let lastDraw = 0;
    let last = 0;
    let nextPulse = 0;
    const pointer = { x: 0, y: 0, active: false };

    const isDark = () => {
      const theme = document.documentElement.getAttribute('data-theme');
      return theme ? theme === 'dark' : darkQuery.matches;
    };

    const applyTheme = () => {
      const dark = isDark();
      palette = dark ? DARK : LIGHT;
      alphaBoost = 1;
    };

    const rgba = (hex: string, a: number) => {
      const n = parseInt(hex.slice(1), 16);
      return `rgba(${n >> 16}, ${(n >> 8) & 255}, ${n & 255}, ${a})`;
    };

    const seed = () => {
      linkDist = small ? 95 : 150;
      const count = Math.max(12, Math.min(small ? 22 : 90, Math.round((w * h) / (small ? 8000 : 7000))));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.28,
        vy: (Math.random() - 0.5) * 0.28,
        r: 1.4 + Math.random() * 1.9,
        c: Math.floor(Math.random() * palette.length),
        glow: 0,
      }));
      pulses = [];
    };

    const resize = () => {
      const rect = hero.getBoundingClientRect();
      w = Math.max(1, Math.round(rect.width));
      h = Math.max(1, Math.round(rect.height));
      small = w < 640;
      dpr = small ? 1 : Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
      if (!running) draw();
    };

    const step = (dt: number) => {
      const k = dt / 16.7;
      for (const n of nodes) {
        if (pointer.active) {
          const dx = pointer.x - n.x;
          const dy = pointer.y - n.y;
          const d2 = dx * dx + dy * dy;
          if (d2 < 170 * 170 && d2 > 1) {
            const d = Math.sqrt(d2);
            const pull = (1 - d / 170) * 0.005;
            n.vx += (dx / d) * pull * k;
            n.vy += (dy / d) * pull * k;
          }
        }
        // Velocidade limitada: a rede se mexe devagar, sem virar bagunça.
        const sp = Math.hypot(n.vx, n.vy);
        if (sp > 0.55) {
          n.vx *= 0.55 / sp;
          n.vy *= 0.55 / sp;
        }
        n.x += n.vx * k;
        n.y += n.vy * k;
        if (n.x < -10 || n.x > w + 10) n.vx *= -1;
        if (n.y < -10 || n.y > h + 10) n.vy *= -1;
        n.glow = Math.max(0, n.glow - 0.02 * k);
      }
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      const links: [Node, Node][] = [];
      const L2 = linkDist * linkDist;

      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const d2 = dx * dx + dy * dy;
          if (d2 > L2) continue;
          const f = 1 - Math.sqrt(d2) / linkDist;
          links.push([a, b]);
          if (small) {
            ctx.strokeStyle = rgba(palette[a.c], f * 0.75 * alphaBoost);
          } else {
            const g = ctx.createLinearGradient(a.x, a.y, b.x, b.y);
            g.addColorStop(0, rgba(palette[a.c], f * 0.75 * alphaBoost));
            g.addColorStop(1, rgba(palette[b.c], f * 0.75 * alphaBoost));
            ctx.strokeStyle = g;
          }
          ctx.lineWidth = 0.6 + f * 0.9;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      // Ponteiro: conecta a rede ao mouse como um neurônio a mais.
      if (pointer.active) {
        const reach = linkDist * 1.35;
        for (const n of nodes) {
          const d = Math.hypot(n.x - pointer.x, n.y - pointer.y);
          if (d > reach) continue;
          ctx.strokeStyle = rgba(palette[n.c], (1 - d / reach) * 0.85 * alphaBoost);
          ctx.lineWidth = 1.1;
          ctx.beginPath();
          ctx.moveTo(pointer.x, pointer.y);
          ctx.lineTo(n.x, n.y);
          ctx.stroke();
        }
        ctx.fillStyle = isDark() ? 'rgba(255, 255, 255, 0.9)' : 'rgba(17, 17, 17, 0.7)';
        ctx.beginPath();
        ctx.arc(pointer.x, pointer.y, 3, 0, Math.PI * 2);
        ctx.fill();
      }

      for (const n of nodes) {
        const col = palette[n.c];
        const halo = n.r * (3.2 + n.glow * 4);
        ctx.fillStyle = rgba(col, (0.2 + n.glow * 0.35) * alphaBoost);
        ctx.beginPath();
        ctx.arc(n.x, n.y, halo, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = rgba(col, Math.min(1, (0.8 + n.glow) * alphaBoost));
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();
      }

      for (const p of pulses) {
        const x = p.a.x + (p.b.x - p.a.x) * p.t;
        const y = p.a.y + (p.b.y - p.a.y) * p.t;
        const col = palette[p.a.c];
        ctx.fillStyle = rgba(col, 0.28 * alphaBoost);
        ctx.beginPath();
        ctx.arc(x, y, 7, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = rgba(col, Math.min(1, 1 * alphaBoost));
        ctx.beginPath();
        ctx.arc(x, y, 2.4, 0, Math.PI * 2);
        ctx.fill();
      }

      return links;
    };

    const frame = (now: number) => {
      raf = 0;
      if (!running) return;
      if (small && now - lastDraw < 30) {
        raf = requestAnimationFrame(frame);
        return;
      }
      lastDraw = now;
      const dt = Math.min(now - (last || now), 50);
      last = now;
      step(dt);
      const links = draw();

      // Sinais viajam pelas conexões: o neurônio de destino acende ao receber.
      nextPulse -= dt;
      if (nextPulse <= 0 && links.length && pulses.length < 14) {
        const [a, b] = links[Math.floor(Math.random() * links.length)];
        pulses.push({ a, b, t: 0, speed: 0.0009 + Math.random() * 0.0012 });
        nextPulse = 140 + Math.random() * 320;
      }
      pulses = pulses.filter((p) => {
        p.t += p.speed * dt;
        if (p.t >= 1) {
          p.b.glow = 1;
          return false;
        }
        return true;
      });

      raf = requestAnimationFrame(frame);
    };

    const start = () => {
      if (!ready || running || reduceMotion.matches || document.hidden) return;
      running = true;
      last = 0;
      raf = requestAnimationFrame(frame);
    };

    const stop = () => {
      running = false;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    };

    applyTheme();
    resize();

    new ResizeObserver(resize).observe(hero);

    // Só anima enquanto a abertura está na tela e a aba está visível.
    let onScreen = true;
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) start();
      else stop();
    }).observe(hero);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : onScreen && start()));

    hero.addEventListener('pointermove', (e) => {
      const rect = hero.getBoundingClientRect();
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;
      pointer.active = true;
    });
    hero.addEventListener('pointerleave', () => {
      pointer.active = false;
    });

    const rethink = () => {
      applyTheme();
      if (reduceMotion.matches) {
        stop();
        pulses = [];
        draw();
      } else if (onScreen) {
        start();
      }
    };
    darkQuery.addEventListener('change', rethink);
    reduceMotion.addEventListener('change', rethink);
    new MutationObserver(rethink).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    if (reduceMotion.matches) draw();

    // A animação só liga depois do load e com a thread ociosa, para não competir com o carregamento da página.
    const begin = () => {
      const go = () => {
        ready = true;
        if (onScreen) start();
      };
      if ('requestIdleCallback' in window) window.requestIdleCallback(go, { timeout: 2500 });
      else setTimeout(go, 600);
    };
    if (document.readyState === 'complete') begin();
    else window.addEventListener('load', begin, { once: true });
  }
</script>

<style>
  .neural-hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(ellipse 60% 120% at 0% 50%, color-mix(in srgb, var(--violet) 9%, transparent), transparent 70%),
      var(--bg);
  }

  .neural-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Escurece (ou clareia) a rede atrás do texto para manter a leitura confortável. */
  .neural-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 48% 120% at 10% 50%, color-mix(in srgb, var(--bg) 78%, transparent) 0%, transparent 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: 56px 52px;
  }

  h1 {
    max-width: 18ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4.2vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: var(--ink-strong);
  }

  p {
    max-width: 52ch;
    margin: 14px 0 0;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .neural-hero::after {
      background: radial-gradient(ellipse 100% 120% at 0% 50%, color-mix(in srgb, var(--bg) 82%, transparent) 0%, transparent 100%);
    }

    .hero-content {
      padding-block: 36px 34px;
    }

    h1 {
      max-width: 16ch;
    }
  }

</style>
