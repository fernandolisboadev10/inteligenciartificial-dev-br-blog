---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---
<!--
  Sem backend próprio (site estático) — este formulário precisa apontar pro
  endpoint de um serviço de e-mail externo (ex.: ConvertKit, Mailchimp,
  Beehiiv). Troque a `action` abaixo pelo endpoint real quando escolher um.
-->
<form class="newsletter" class:list={{ compact }} action="https://api.example-esp.com/subscribe" method="POST">
  <input type="email" name="email" placeholder="voce@email.com" required aria-label="E-mail" />
  <button type="submit" class="button button-primary">Assinar</button>
</form>

<style>
  .newsletter {
    display: flex;
    gap: 10px;
    width: 100%;
    max-width: 420px;
  }

  input {
    flex: 1;
    min-width: 0;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    background: var(--surface);
    color: var(--ink);
  }

  input:focus {
    border-color: var(--violet);
  }

  .compact {
    max-width: 320px;
  }
</style>
