---
import { socials } from '../data/socials';
---
<aside class="author-bio">
  <img src="/images/fernando-lisboa.png" alt="Fernando Lisboa" class="author-photo" width="100" height="100" loading="lazy" />
  <div class="author-body">
    <p class="author-name">Fernando Lisboa</p>
    <p class="author-text">Analista de sistemas independente e redator de tecnologia, apaixonado por IA e robótica. Criei o Inteligência Artificial Dev para separar o que é útil do que é ruído.</p>
    <ul class="author-social" aria-label="Redes sociais de Fernando Lisboa">
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer me" aria-label={s.label} title={s.label}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .author-body {
    min-width: 0;
  }

  .author-social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 14px 0 0;
    padding: 0;
  }

  .author-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--violet);
    color: var(--violet);
    background: transparent;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .author-social a:hover,
  .author-social a:focus-visible {
    background: var(--violet);
    color: var(--bg);
    transform: translateY(-2px);
  }

  @media (max-width: 560px) {
    .author-social {
      justify-content: center;
    }
  }

  .author-bio {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .author-photo {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-name {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink-strong);
  }

  .author-text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  @media (max-width: 560px) {
    .author-bio {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
