---
import { socials } from '../data/socials';
import { site } from '../data/site';

const { t } = site;
---
<aside class="author-bio">
  <img src="/images/fernando-lisboa.png" alt="Fernando Lisboa" class="author-photo" width="88" height="88" loading="lazy" />
  <div class="author-body">
    <p class="eyebrow">{t.writtenBy}</p>
    <p class="author-name">Fernando Lisboa</p>
    <p class="author-text">{t.authorBio}</p>
    <ul class="author-social" aria-label={t.authorSocial}>
      {socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer me" aria-label={s.label} title={s.label}>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .author-bio {
    display: flex;
    gap: 22px;
    align-items: flex-start;
    margin-top: 40px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
  }

  .author-photo {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    border-radius: 6px;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .author-body {
    min-width: 0;
  }

  .author-name {
    margin: 6px 0 6px;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--ink-strong);
  }

  .author-text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .author-social {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 14px 0 0;
    padding: 0;
  }

  .author-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 4px;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .author-social a:hover,
  .author-social a:focus-visible {
    border-color: var(--violet);
    color: var(--link-text);
  }

  @media (max-width: 560px) {
    .author-bio {
      flex-direction: column;
    }
  }
</style>
