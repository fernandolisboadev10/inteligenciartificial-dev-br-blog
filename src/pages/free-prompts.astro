---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const samplePrompts = [
  {
    task: 'Explicar um erro',
    prompt: 'Explique este erro como se eu tivesse 5 minutos antes de uma reunião: [cole o erro]. Dê a causa provável e a correção mais direta.',
  },
  {
    task: 'Revisar uma função',
    prompt: 'Revise esta função em busca de bugs, casos extremos não tratados e oportunidades de simplificação, sem mudar sua assinatura pública: [cole o código]',
  },
  {
    task: 'Escrever testes',
    prompt: 'Gere testes unitários para esta função cobrindo o caminho feliz, um erro esperado e um caso extremo não óbvio: [cole o código]',
  },
  {
    task: 'Documentar uma API',
    prompt: 'Escreva a documentação desta rota de API em formato OpenAPI, incluindo um exemplo de requisição e resposta: [cole o código da rota]',
  },
];
---
<BaseLayout title="Prompts Grátis" description="Uma amostra gratuita de prompts de IA testados para desenvolvedores.">
  <section class="container intro">
    <h1>Prompts grátis para desenvolvedores</h1>
    <p>
      Uma amostra de 4 prompts da nossa biblioteca. Deixe seu e-mail pra
      receber os outros 16 direto na sua caixa de entrada — e saber quando
      novos prompts saírem.
    </p>
    <NewsletterForm />
  </section>

  <section class="container prompts">
    {samplePrompts.map((p) => (
      <div class="prompt-card">
        <p class="task">{p.task}</p>
        <pre><code>{p.prompt}</code></pre>
      </div>
    ))}
  </section>

  <section class="container locked">
    <p class="locked-label">+ 16 prompts (e-mail necessário)</p>
    <p class="locked-copy">
      Debugging avançado, refatoração segura, geração de testes de
      integração, prompts de revisão de PR e muito mais.
    </p>
  </section>
</BaseLayout>

<style>
  .intro {
    padding-block: 56px 32px;
    max-width: 60ch;
  }

  .intro p {
    color: var(--ink-soft);
    margin: 16px 0 28px;
  }

  .prompts {
    display: grid;
    gap: 20px;
    padding-block: 24px;
  }

  .prompt-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 20px 24px;
    background: var(--surface);
  }

  .task {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--violet);
    margin: 0 0 12px;
  }

  pre {
    margin: 0;
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--ink);
  }

  .locked {
    margin-block: 40px 80px;
    padding: 32px;
    border: 1px dashed var(--line);
    border-radius: 8px;
    text-align: center;
  }

  .locked-label {
    font-family: var(--font-mono);
    color: var(--ink-strong);
    font-weight: 500;
    margin: 0 0 8px;
  }

  .locked-copy {
    color: var(--ink-soft);
    margin: 0;
    max-width: 48ch;
    margin-inline: auto;
  }
</style>
