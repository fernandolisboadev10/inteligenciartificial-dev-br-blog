---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const items = [
  'Um prompt novo e testado toda semana',
  'Comparações diretas de ferramentas de IA para desenvolvedores',
  'Aviso antecipado de novos guias e atualizações do site',
];
---
<BaseLayout title="Newsletter" description="Prompts e notícias de IA toda semana, direto na sua caixa de entrada.">
  <section class="container newsletter-page">
    <h1>Um prompt novo, toda semana.</h1>
    <p class="sub">Direto na sua caixa de entrada. Sem spam, sem enrolação.</p>

    <ul class="items">
      {items.map((item) => <li>{item}</li>)}
    </ul>

    <NewsletterForm />
  </section>
</BaseLayout>

<style>
  .newsletter-page {
    padding-block: 64px 96px;
    max-width: 56ch;
  }

  .sub {
    color: var(--ink-soft);
    margin: 12px 0 32px;
  }

  .items {
    list-style: none;
    padding: 0;
    margin: 0 0 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .items li {
    padding-left: 20px;
    position: relative;
    color: var(--ink-soft);
  }

  .items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 8px;
    background: var(--teal);
    border-radius: 50%;
  }
</style>
