---
import BaseLayout from '../layouts/BaseLayout.astro';

const whatsappNumber = '5599984912523';
const whatsappDisplay = '(99) 98491-2523';
const contactEmail = 'inteligenciartificial.dev@gmail.com';
---
<BaseLayout title="Contate-nos" description="Fale com o Inteligência Artificial Dev por WhatsApp, e-mail ou pelo formulário de contato.">
  <section class="container contact">
    <h1>Contate-nos</h1>

    <div class="layout">
      <div class="info">
        <a class="info-row" href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
          </svg>
          <span>{whatsappDisplay}</span>
        </a>
        <a class="info-row" href={`mailto:${contactEmail}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 6-10 7L2 6" />
          </svg>
          <span>{contactEmail}</span>
        </a>
      </div>

      <!--
        Sem backend próprio (site estático) — este formulário precisa apontar
        pro endpoint de um serviço externo (ex.: Formspree). Troque a `action`
        abaixo pelo endpoint real quando escolher um.
      -->
      <form class="form" action="https://formspree.io/f/your-form-id" method="POST">
        <input type="text" name="name" placeholder="Nome" required aria-label="Nome" />
        <input type="email" name="email" placeholder="E-mail" required aria-label="E-mail" />
        <textarea name="message" placeholder="Mensagem" rows="6" required aria-label="Mensagem"></textarea>
        <button type="submit" class="button button-primary">Enviar</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-block: 56px 80px;
  }

  .contact h1 {
    margin-bottom: 32px;
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 40px;
    align-items: start;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .info-row {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink-strong);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .info-row svg {
    flex-shrink: 0;
    color: var(--violet);
  }

  .info-row:hover {
    color: var(--violet);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
  }

  .form input,
  .form textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    background: var(--bg);
    color: var(--ink);
    resize: vertical;
  }

  .form input:focus,
  .form textarea:focus {
    border-color: var(--violet);
  }

  .form .button {
    align-self: flex-start;
  }

  @media (max-width: 700px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
