---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedGrid from '../components/FeaturedGrid.astro';
import Pagination from '../components/Pagination.astro';

const PER_PAGE = 9;
const page = Number(Astro.props.page ?? 1);
const all = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = page === 1 ? all.slice(0, 3) : [];
const gridAll = all.slice(3);
const totalPages = Math.max(1, Math.ceil(gridAll.length / PER_PAGE));
const rest = gridAll.slice((page - 1) * PER_PAGE, page * PER_PAGE);
---
<BaseLayout title={page > 1 ? `Prompts de IA para Desenvolvedores - Página ${page}` : "Prompts de IA para Desenvolvedores"}>
  {page === 1 && <h1 class="sr-only">Prompts de IA testados pra quem escreve código.</h1>}

  {page === 1 && (
  <section class="container featured-wrap">
    <div class="recent-header">
      <div>
        <h2>Para ler hoje</h2>
        <span class="underline"></span>
      </div>
    </div>
    <FeaturedGrid posts={featured} />
  </section>
  )}

  <section class="container recent">
    <div class="recent-header">
      <div>
        <h2>Mais recentes</h2>
        <span class="underline"></span>
      </div>
      <a href="/blog">Ver todos →</a>
    </div>
    <div class="grid">
      {rest.map((post, i) => (
        <PostCard
          priority={i === 0}
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          date={post.data.date}
          readingTime={post.data.readingTime}
          image={post.data.image}
          imageAlt={post.data.imageAlt}
        />
      ))}
    </div>
    <Pagination current={page} total={totalPages} />
  </section>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .featured-wrap {
    padding-block: 32px 8px;
  }

  .recent {
    padding-block: 40px;
  }

  .recent-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
  }

  .underline {
    display: block;
    width: 48px;
    height: 4px;
    margin-top: 10px;
    border-radius: 2px;
    background: linear-gradient(135deg, var(--violet), var(--rose));
  }

  .recent-header a {
    text-decoration: none;
    color: var(--teal-text);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

</style>
